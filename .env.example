# Copy to .env.local (gitignored) and fill in. Never commit real values.
# In CI these come from GitHub environment secrets.
# When you add a variable anywhere in the code, add it here too.

# --- Supabase (shown by `supabase start` locally) ---
# Public: safe to ship to the browser. RLS policies protect the data.
# Web app reads these from web/.env.local (Next.js only loads env files from its own folder).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# "Publishable key" (sb_publishable_...), replaces the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret: bypasses RLS. Server-side and worker only, never NEXT_PUBLIC_.
# "Secret key" (sb_secret_...), replaces the legacy service_role key (SUPABASE_SERVICE_ROLE_KEY).
# Web: only the account-deletion server action uses it (web/src/lib/supabase/admin.ts, ADR 0006).
# Set it in the web server's environment (Vercel: server-side env var, not exposed to the browser).
# The web e2e tests also use it locally to inspect stored uploads.
SUPABASE_SECRET_KEY=
# Direct Postgres connection used by the worker (queue + results)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Error tracking: Sentry (#35) ---
# All optional. Leave the DSNs empty and Sentry is off (local dev, CI, tests).
# A DSN only says where to send events; it is not a secret, but keep it out of git anyway.
#
# Web (web/.env.local, Vercel). Public: inlined into the browser bundle and also read
# by the web server. Use the DSN of the Sentry "web" project.
NEXT_PUBLIC_SENTRY_DSN=
# Public, optional: overrides the environment tag. Defaults to Vercel's VERCEL_ENV
# (development / preview / production), or "development" locally.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Build time only (Vercel), for source-map upload. Without SENTRY_AUTH_TOKEN the build
# skips source maps entirely. The release is the git SHA (VERCEL_GIT_COMMIT_SHA).
SENTRY_ORG=
SENTRY_PROJECT=
# Secret: Sentry org auth token. Vercel env var (build), never NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
#
# Worker (Cloud Run env, #33). Server-side. DSN of the Sentry "worker" project.
SENTRY_DSN=
# development / preview / production (defaults to development).
SENTRY_ENVIRONMENT=
# Git SHA of the deployed image, set at deploy time.
SENTRY_RELEASE=
