# Copy to .env.local (gitignored) and fill in. Never commit real values.
# In CI these come from GitHub environment secrets.
# When you add a variable anywhere in the code, add it here too.

# --- Supabase (shown by `supabase start` locally) ---
# Public: safe to ship to the browser. RLS policies protect the data.
# Web app reads these from web/.env.local (Next.js only loads env files from its own folder).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# "Publishable key" (sb_publishable_...), replaces the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret: bypasses RLS. Server-side and worker only, never NEXT_PUBLIC_.
# "Secret key" (sb_secret_...), replaces the legacy service_role key.
# Locally the web e2e tests use it to inspect stored uploads; the web app itself never does.
SUPABASE_SECRET_KEY=
# Direct Postgres connection used by the worker (queue + results)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Error tracking (Milestone 6) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
