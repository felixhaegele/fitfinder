    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@next/env": "16.4.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
